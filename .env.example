# MotoDC Environment Variables Configuration
# Copy this file to .env.local for local development, or add these to your Vercel Project Settings:
# Vercel Dashboard -> Settings -> Environment Variables

# ==============================================================
# Cloudinary (Required for Product Image Uploads in Admin Panel)
# ==============================================================
# 1. Sign up free at https://cloudinary.com
# 2. From your Cloudinary Dashboard, copy your "Cloud name":
VITE_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name

# 3. In Cloudinary: Settings (gear icon) -> Upload -> Add upload preset
#    - Set "Upload preset name" (e.g. motodc_products)
#    - Set "Signing Mode" to "Unsigned" (CRITICAL: Must be Unsigned!)
#    - Set Folder to: motodc/products
#    - Click Save, and paste the preset name below:
VITE_CLOUDINARY_UPLOAD_PRESET=your_unsigned_preset_name

# ==============================================================
# Algolia (High-Speed Typo-Tolerant Search Engine)
# ==============================================================
ALGOLIA_APP_ID=04KTVI2AAM
ALGOLIA_ADMIN_KEY=your_algolia_admin_key
VITE_ALGOLIA_APP_ID=04KTVI2AAM
VITE_ALGOLIA_SEARCH_KEY=your_algolia_search_only_key

