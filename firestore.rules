rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, create, update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false;
    }

    function isAdmin() {
      return request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /admins/{userId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /orders/{category} {
      allow read: if isAdmin();
      allow write: if false;
      match /records/{orderId} {
        allow read: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());
        allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
        allow update: if isAdmin() || (
          request.auth != null &&
          resource.data.userId == request.auth.uid &&
          request.resource.data.userId == resource.data.userId &&
          request.resource.data.orderStatus == 'cancelled' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['orderStatus', 'statusHistory'])
        );
        allow delete: if false;
      }
    }

    match /paymentIntents/{category} {
      allow read, write: if false;
      match /records/{intentId} {
        allow read, write: if false;
      }
    }

    match /request/{requestGroup} {
      allow read: if isAdmin();
      allow create, update: if request.auth != null && !isAdmin();
      allow delete: if false;

      match /{requestType}/{requestId} {
        allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
        allow read: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());
        allow update: if isAdmin();
        allow delete: if false;
      }
    }

    // Legacy collection retained for historical records.
    match /returns/{returnId} {
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow read: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());
      allow update: if isAdmin();
      allow delete: if false;
    }
  }
}
